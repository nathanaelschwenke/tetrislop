# Copy to .env.local (git-ignored) and fill in your Supabase project values.
# Supabase dashboard -> Project Settings -> API
#
# Without these values the game still runs; finished games are printed to the
# browser console instead of being uploaded.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
